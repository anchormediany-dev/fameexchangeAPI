# ── Database ─────────────────────────────────────────────────────────────────
DB_URL=mongodb://localhost:27017/fameexchange

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5006
NODE_ENV=development
# Base URL this server considers itself reachable at — fallback source for
# OAuth redirect URIs when a provider-specific one isn't set.
BASE_URL=http://localhost:5006

# ── Cron schedule overrides (all optional — each has an in-code default) ──────
FAMESCORE_CRON_SCHEDULE=0 3 * * *
FUTURES_CRON_SCHEDULE=0 4 * * *
VESTING_UNLOCK_CRON_SCHEDULE=0 5 * * *
STAKE_UNLOCK_CRON_SCHEDULE=30 5 * * *
ROYALTY_PAYOUT_CRON_SCHEDULE=0 9 1 * *
DIVIDEND_CRON_SCHEDULE=0 9 1 1,4,7,10 *

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET_KEY=replace_with_64_char_hex_secret

# ── Email (Resend) ───────────────────────────────────────────────────────────
# API key from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Sender address — must be on a domain verified with Resend, or use their
# sandbox sender (onboarding@resend.dev) before a domain is verified.
MAIL_FROM_EMAIL=noreply@yourdomain.com
MAIL_FROM_NAME=The Fame Exchange

# ── Google APIs ───────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=AIza...
GOOGLE_CLIENT_ID=123456789-xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
# Obtain from Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
# Optional separate secret for product webhook endpoint (falls back to STRIPE_WEBHOOK_SECRET)
STRIPE_PRODUCT_WEBHOOK_SECRET=whsec_...

# ── TikTok OAuth ──────────────────────────────────────────────────────────────
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

# ── Facebook OAuth ────────────────────────────────────────────────────────────
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# ── Twitter/X OAuth + API ─────────────────────────────────────────────────────
TWITTER_CLIENT_ID=your_twitter_oauth_client_id
TWITTER_CLIENT_SECRET=your_twitter_oauth_client_secret
# Set to "true" to use the official Twitter API instead of the Puppeteer
# scraper fallback (scrapers/twitterScraper.js) for follower counts.
TWITTER_API_ENABLED=false
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# ── AWS S3 (file uploads — see config/s3Config.js) ─────────────────────────────
AWS_REGION=us-east-1
AWS_S3_BUCKET=fameexchange-media
# Optional — separate bucket for user-uploaded media if it differs from
# AWS_S3_BUCKET. Defaults to AWS_S3_BUCKET when unset.
AWS_S3_MEDIA_BUCKET=
# Optional — set once a CloudFront distribution fronts the bucket (infra/,
# Phase 5); uploaded-file URLs are served through this instead of the raw S3
# object URL. Leave unset locally.
AWS_S3_CDN_BASE_URL=
# Local dev only — in production, App Runner's instance role provides
# credentials automatically and these should be left unset.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Public URLs (used for OAuth redirects and notification links) ─────────────
BACKEND_PUBLIC_URL=https://api.thefameexchange.com
FRONTEND_PUBLIC_URL=https://app.thefameexchange.com
APP_BASE_URL=https://app.thefameexchange.com
FAMEFUTURES_PUBLIC_URL=https://famefutures.com

# ── FameFutures SSO handoff ───────────────────────────────────────────────────
# Shared secret for signing short-lived handoff tokens so a Future-tier talent
# clicking through to famefutures.com can land already logged in there.
# MUST be the same value configured on the famefutures.com backend, which is
# a separate codebase/deployment. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FAMEFUTURES_SSO_SECRET=replace_with_64_char_hex_secret

# ── Solana (services/solana/) ──────────────────────────────────────────────────
# TFE talent-share ledger — tfe_transfer_hook / tfe_kyc_registry /
# tfe_token_minter / tfe_exchange. Not Famecoin; unrelated project.
HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=your_helius_api_key

# Each on-chain role below is resolved by services/solana/signers.ts as:
# Fireblocks first (if FIREBLOCKS_{ROLE}_VAULT_ACCOUNT_ID is set), else an
# env-var keypair (SOLANA_{ROLE}_PRIVATE_KEY). Never store either kind of key
# in the database — only here / in your secrets manager / in Fireblocks' own
# custody. A key may be base58-encoded (solana-keygen's default output) or a
# JSON `[1,2,...]` byte array.
#
# Roles:
#   TOKEN_MINTER_ADMIN  — tfe_token_minter Config.admin_authority (signs create_talent_token)
#   KYC_BACKEND         — tfe_kyc_registry Config.backend_authority (signs register_user)
#   KYC_ADMIN           — tfe_kyc_registry Config.admin_authority (signs verify_user)
#   EXCHANGE_EXECUTOR   — pays/signs tfe_exchange execute_trade as the crank (on-chain permissionless, but a real key is still needed to submit it)
SOLANA_TOKEN_MINTER_ADMIN_PRIVATE_KEY=
SOLANA_KYC_BACKEND_PRIVATE_KEY=
SOLANA_KYC_ADMIN_PRIVATE_KEY=
SOLANA_EXCHANGE_EXECUTOR_PRIVATE_KEY=

# Fireblocks (optional — omit entirely to use the env-var keypairs above instead).
# FIREBLOCKS_SECRET_KEY is PEM contents, not a file path.
FIREBLOCKS_API_KEY=
FIREBLOCKS_SECRET_KEY=
FIREBLOCKS_BASE_PATH=https://api.fireblocks.io/v1
FIREBLOCKS_SOLANA_ASSET_ID=SOL
# Per role, only needed for roles you want signed via Fireblocks:
# FIREBLOCKS_TOKEN_MINTER_ADMIN_VAULT_ACCOUNT_ID=
# FIREBLOCKS_KYC_BACKEND_VAULT_ACCOUNT_ID=
# FIREBLOCKS_KYC_ADMIN_VAULT_ACCOUNT_ID=
# FIREBLOCKS_EXCHANGE_EXECUTOR_VAULT_ACCOUNT_ID=
