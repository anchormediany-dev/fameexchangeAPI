  "types": [
    {
      "name": "Config",
      "docs": [
        "Singleton config account holding the two governing authorities.",
        "`admin_authority` is expected to eventually be a PDA controlled by the",
        "TFE platform program (not yet built) — until then it's whatever pubkey",
        "`initialize` was called with, rotatable via `update_admin_authority`",
        "without a redeploy."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "admin_authority",
            "docs": [
              "Can call verify_user, revoke_verification, update_admin_authority,",
              "and update_backend_authority."
            ],
            "type": "pubkey"
          },
          {
            "name": "backend_authority",
            "docs": [
              "Can call register_user. Deliberately a separate, lower-trust role",
              "from admin_authority — the TFE backend can create pending records but",
              "cannot itself grant or revoke verification."
            ],
            "type": "pubkey"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "KycRecord",
      "docs": [
        "PDA seeds: `[\"kyc\", wallet]`, one per wallet. See constants.rs.",
        "",
        "`verified`/`kyc_tier` and `revoked` are deliberately independent fields",
        "(per spec) rather than a single enum, preserving the historical fact that",
        "a wallet WAS verified even after a later revocation — the *effective*",
        "current status callers should treat as \"verified\" is `verified &&",
        "!revoked` (see `handle_is_verified`), not `verified` alone."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "wallet",
            "type": "pubkey"
          },
          {
            "name": "user_id_hash",
            "docs": [
              "Hash of the TFE user ID — never the raw ID, so this account never",
              "stores PII directly on-chain."
            ],
            "type": {
              "array": [
                "u8",
                32
              ]
            }
          },
          {
            "name": "kyc_tier",
            "docs": [
              "0 = none, 1 = basic, 2 = full. See KYC_TIER_* in constants.rs."
            ],
            "type": "u8"
          },
          {
            "name": "verified",
            "type": "bool"
          },
          {
            "name": "verified_at",
            "type": "i64"
          },
          {
            "name": "revoked",
            "type": "bool"
          },
          {
            "name": "revoked_at",
            "type": "i64"
          },
          {
            "name": "bump",
            "type": "u8"
          }
        ]
      }
    },
    {
      "name": "KycRevokedEvent",
      "docs": [
        "Requirement #6: emitted on every successful revoke_verification call."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "wallet",
            "type": "pubkey"
          },
          {
            "name": "revoked_at",
            "type": "i64"
          }
        ]
      }
    },
    {
      "name": "KycVerifiedEvent",
      "docs": [
        "Requirement #6: emitted on every successful verify_user call, for",
        "off-chain indexing."
      ],
      "type": {
        "kind": "struct",
        "fields": [
          {
            "name": "wallet",
            "type": "pubkey"
          },
          {
            "name": "kyc_tier",
            "type": "u8"
          },
          {
            "name": "verified_at",
            "type": "i64"
          }
        ]
      }
    }
  ],
  "constants": [
    {
      "name": "CONFIG_SEED",
      "docs": [
        "Seed for the singleton Config PDA holding admin_authority/backend_authority."
      ],
      "type": "bytes",
      "value": "[99, 111, 110, 102, 105, 103]"
    },
    {
      "name": "KYC_RECORD_SEED",
      "docs": [
        "Seed prefix for a wallet's KycRecord PDA: `[\"kyc\", wallet_pubkey]`.",
        "This exact seed scheme is what `tfe_transfer_hook` derives against —",
        "changing it is a breaking change for that program too."
      ],
      "type": "bytes",
      "value": "[107, 121, 99]"
    },
    {
      "name": "KYC_TIER_BASIC",
      "type": "u8",
      "value": "1"
    },
    {
      "name": "KYC_TIER_FULL",
      "type": "u8",
      "value": "2"
    },
    {
      "name": "KYC_TIER_NONE",
      "docs": [
        "kyc_tier values. 0 (none) is the only tier a freshly-registered,",
        "not-yet-verified record may hold; verify_user requires BASIC or FULL."
      ],
      "type": "u8",
      "value": "0"
    }
  ]
